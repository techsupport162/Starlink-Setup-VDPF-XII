<title>Peñafrancia XII Wi-Fi Runbook</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Source+Sans+3:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
<style>
/* Layout: centered runbook column; phases stack, steps hang off a numbered rail. Red family accents, green kept for "verify". */
:root {
  --bg: #fbf7f7;
  --surface: #ffffff;
  --sunk: #f6efef;
  --ink: #231a1b;
  --muted: #6e6062;
  --line: #ecdfe0;
  --red: #c8102e;
  --red-hi: #e2404d;
  --red-deep: #7d0b1d;
  --tint: #fdecee;
  --tint-line: #f5c9ce;
  --s1: #8f0d22;
  --s2: #c8102e;
  --s3: #e0503f;
  --s4: #b81d55;
  --ok: #2e7a48;
  --ok-bg: #eef7f1;
  --ok-line: #cbe5d4;
  --warn: #9a5800;
  --warn-bg: #fff5e6;
  --warn-line: #f2d9ac;
  --code: #a3172f;
  --display: "Manrope", "Segoe UI", system-ui, sans-serif;
  --body: "Source Sans 3", "Segoe UI", system-ui, sans-serif;
  --mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #151011; --surface: #1e1718; --sunk: #241c1d; --ink: #f3ebeb; --muted: #b5a6a8; --line: #362a2c;
    --red: #ff5a69; --red-hi: #ff8e92; --red-deep: #ff3a50; --tint: #2d1a1d; --tint-line: #5a2a31;
    --s1: #ff6b7c; --s2: #ff5a69; --s3: #ff8a6e; --s4: #ff6f9c;
    --ok: #74d197; --ok-bg: #13231a; --ok-line: #24472f; --warn: #f2b65c; --warn-bg: #2a2013; --warn-line: #4d3a1d;
    --code: #ff9aa5; color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #151011; --surface: #1e1718; --sunk: #241c1d; --ink: #f3ebeb; --muted: #b5a6a8; --line: #362a2c;
  --red: #ff5a69; --red-hi: #ff8e92; --red-deep: #ff3a50; --tint: #2d1a1d; --tint-line: #5a2a31;
  --s1: #ff6b7c; --s2: #ff5a69; --s3: #ff8a6e; --s4: #ff6f9c;
  --ok: #74d197; --ok-bg: #13231a; --ok-line: #24472f; --warn: #f2b65c; --warn-bg: #2a2013; --warn-line: #4d3a1d;
  --code: #ff9aa5; color-scheme: dark;
}

* { box-sizing: border-box; }
body {
  background: var(--bg); color: var(--ink);
  font-family: var(--body); font-size: 16px; line-height: 1.6;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
.wrap { max-width: 860px; margin: 0 auto; padding-block: 48px 72px; }
h1, h2, h3 { font-family: var(--display); text-wrap: balance; margin: 0; }
code { font-family: var(--mono); font-size: .86em; background: var(--sunk); padding: 1px 6px; border-radius: 4px; }
a { color: var(--red); }
a:focus-visible, button:focus-visible, input:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }

/* Hero */
.hero { text-align: center; display: grid; justify-items: center; gap: 14px; }
.badge {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--mono); font-size: 12px; letter-spacing: .04em;
  padding: 5px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--muted);
}
.badge::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--red); }
.hero h1 { font-size: clamp(30px, 6vw, 46px); line-height: 1.12; font-weight: 800; letter-spacing: -.02em; }
.grad {
  background: linear-gradient(90deg, var(--red-deep), var(--red) 50%, var(--red-hi));
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.hero p { color: var(--muted); max-width: 60ch; margin: 0; font-size: 17px; }
.vessel { font-size: 14px; color: var(--muted); }
.vessel strong { color: var(--ink); }

.stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; width: 100%; margin-top: 18px; }
.stat { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 12px 10px; }
.stat b { display: block; font-family: var(--display); font-size: 24px; color: var(--red); font-variant-numeric: tabular-nums; }
.stat span { font-size: 13px; color: var(--muted); }

.pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 26px; }
.pill {
  display: inline-flex; align-items: center; gap: 8px; text-decoration: none; color: var(--ink);
  font-size: 14px; padding: 8px 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface);
  transition: border-color .15s, transform .15s;
}
.pill:hover { border-color: var(--tint-line); transform: translateY(-1px); }
.pill i { width: 8px; height: 8px; border-radius: 50%; background: var(--c); }

/* Phase */
.phase { margin-top: 64px; --c: var(--s2); scroll-margin-top: 16px; }
.phase-head { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 14px; align-items: start; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
.icon {
  width: 42px; height: 42px; border-radius: 10px; display: grid; place-items: center;
  background: var(--tint); color: var(--c);
}
.icon svg { width: 22px; height: 22px; }
.phase-head h2 { font-size: 22px; color: var(--c); font-weight: 700; }
.phase-head p { margin: 4px 0 0; color: var(--muted); font-size: 15px; }
.tag { font-family: var(--mono); font-size: 12px; color: var(--muted); border: 1px solid var(--line); border-radius: 6px; padding: 3px 8px; background: var(--surface); white-space: nowrap; }

/* Steps */
.steps { list-style: none; margin: 0; padding: 26px 0 0; display: grid; gap: 28px; position: relative; }
.steps::before { content: ""; position: absolute; left: 15px; top: 34px; bottom: 8px; width: 2px; background: var(--line); }
.step { display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: 14px; position: relative; }
.num {
  width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center;
  border: 2px solid var(--c); background: var(--bg); color: var(--c);
  font-family: var(--display); font-weight: 700; font-size: 14px; font-variant-numeric: tabular-nums;
}
.step-body { min-width: 0; display: grid; gap: 10px; }
.step h3 { font-size: 17px; font-weight: 700; padding-top: 4px; }
.step p { margin: 0; color: var(--muted); }
.step ul { margin: 0; padding-left: 20px; color: var(--muted); }
.step li { margin: 2px 0; }

.codebox { position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 14px 92px 14px 16px; overflow-x: auto; }
.codebox pre { margin: 0; font-family: var(--mono); font-size: 13.5px; color: var(--code); white-space: pre; }
.copy {
  position: absolute; top: 10px; right: 10px; font: 500 12px var(--body);
  padding: 4px 12px; border-radius: 6px; border: 1px solid var(--line); background: var(--sunk); color: var(--ink); cursor: pointer;
}
.copy:hover { border-color: var(--tint-line); }

.note { border-radius: 10px; padding: 12px 16px; display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 10px; font-size: 15px; }
.note b { font-weight: 600; }
.verify { background: var(--ok-bg); border: 1px solid var(--ok-line); }
.verify::before { content: "✓"; color: var(--ok); font-weight: 700; }
.warn { background: var(--warn-bg); border: 1px solid var(--warn-line); }
.warn::before { content: "!"; color: var(--warn); font-weight: 800; text-align: center; }
.info { background: var(--tint); border: 1px solid var(--tint-line); }
.info::before { content: "i"; color: var(--red); font-weight: 800; font-family: var(--display); text-align: center; }

/* Tables */
.tablebox { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); margin-top: 22px; }
table { width: 100%; border-collapse: collapse; font-size: 14.5px; min-width: 560px; }
th { text-align: left; font-family: var(--display); font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); background: var(--sunk); padding: 10px 14px; border-bottom: 1px solid var(--line); }
td { padding: 10px 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
tr:last-child td { border-bottom: 0; }
td.qty { font-variant-numeric: tabular-nums; font-weight: 600; white-space: nowrap; }
.chip { display: inline-block; font-size: 12px; font-weight: 600; padding: 1px 9px; border-radius: 999px; white-space: nowrap; }
.chip.have { background: var(--ok-bg); color: var(--ok); border: 1px solid var(--ok-line); }
.chip.buy { background: var(--tint); color: var(--red); border: 1px solid var(--tint-line); }
.chip.maybe { background: var(--warn-bg); color: var(--warn); border: 1px solid var(--warn-line); }
.chip.no { background: var(--sunk); color: var(--muted); border: 1px solid var(--line); }

/* Topology flow */
.flow { display: flex; flex-wrap: wrap; align-items: stretch; gap: 8px; margin-top: 22px; }
.node { flex: 1 1 130px; min-width: 0; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
.node b { display: block; font-family: var(--display); font-size: 14px; }
.node span { font-size: 13px; color: var(--muted); }
.node.hot { border-color: var(--red); background: var(--tint); }
.arrow { align-self: center; color: var(--muted); font-size: 18px; }

/* Deck map */
.decks { display: grid; gap: 18px; margin-top: 22px; }
.deck h4 { margin: 0 0 8px; font-family: var(--display); font-size: 14px; display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
.deck h4 small { font-family: var(--body); font-weight: 500; color: var(--muted); font-size: 13px; }
.hull { display: flex; flex-wrap: wrap; gap: 6px; padding: 6px; border: 1.5px solid var(--line); border-radius: 10px 40px 40px 10px; background: var(--surface); }
.room { flex: var(--w, 1) 1 110px; min-width: 0; border: 1px dashed var(--line); border-radius: 6px; padding: 8px 10px; min-height: 72px; display: grid; align-content: space-between; gap: 6px; }
.room b { font-size: 13.5px; font-weight: 600; }
.room.eq { background: var(--tint); border: 1.5px solid var(--red); border-style: solid; }
.room.mute b { color: var(--muted); font-weight: 500; }
.dots { display: flex; gap: 5px; align-items: center; font-size: 12px; color: var(--muted); }
.ap { width: 12px; height: 12px; border-radius: 50%; background: var(--red); }
.ap.out { background: transparent; border: 2.5px solid var(--red); }
.dish { width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--red-deep); background: var(--tint); }
.legend { display: flex; flex-wrap: wrap; gap: 16px; font-size: 13px; color: var(--muted); margin-top: 4px; }
.legend span { display: inline-flex; align-items: center; gap: 6px; }

/* Topology */
.topo-box { overflow-x: auto; margin-top: 22px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); padding: 12px; }
.topo { display: block; width: 100%; min-width: 720px; height: auto; font-family: var(--body); }
.topo text { fill: var(--ink); font-size: 12px; }
.topo .m { fill: var(--muted); }
.topo .b { font-weight: 600; }
.topo .s { font-size: 11.5px; }
.topo .xs { font-size: 10.5px; }
.topo .hull { fill: none; stroke: var(--muted); stroke-opacity: .45; stroke-width: 1.5; }
.topo .room { fill: var(--bg); stroke: var(--line); stroke-dasharray: 4 3; }
.topo .room.eq { fill: var(--tint); stroke: var(--red); stroke-dasharray: none; stroke-width: 1.5; }
.topo .chip { fill: var(--surface); stroke: var(--red); stroke-width: 1; }
.topo .ap { fill: var(--red); }
.topo .ap.pend { fill: var(--surface); stroke: var(--red); stroke-width: 2.5; }
.topo .dish { fill: var(--tint); stroke: var(--red-deep); stroke-width: 2; }
.topo .cable { fill: none; stroke: var(--red); stroke-width: 1.5; }
.topo .cable.d { stroke: var(--red-deep); stroke-dasharray: 5 4; }
.topo .wire { fill: none; stroke: var(--muted); stroke-width: 1.2; }
.topo .arrowhead { fill: var(--red); }
.cab { width: 22px; height: 0; border-top: 2px solid var(--red); display: inline-block; }
.cab.d { border-top: 2px dashed var(--red-deep); }

/* Checklist */
.checklist { list-style: none; padding: 0; margin: 22px 0 0; display: grid; gap: 6px; }
.checklist label { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 10px; align-items: start; padding: 10px 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); cursor: pointer; }
.checklist input { width: 18px; height: 18px; margin: 3px 0 0; accent-color: var(--red); }
.checklist input:checked + span { color: var(--muted); text-decoration: line-through; }
.progress { display: flex; align-items: center; gap: 12px; margin-top: 18px; font-size: 14px; color: var(--muted); font-variant-numeric: tabular-nums; }
.bar { flex: 1; height: 6px; border-radius: 99px; background: var(--line); overflow: hidden; }
.bar i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--red-deep), var(--red-hi)); transition: width .25s; }

.open { margin-top: 22px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 16px 18px; }
.open h4 { margin: 0 0 6px; font-family: var(--display); font-size: 15px; }
.open ul { margin: 0; padding-left: 20px; color: var(--muted); }

footer { margin-top: 72px; padding-top: 22px; border-top: 1px solid var(--line); font-size: 13.5px; color: var(--muted); display: grid; gap: 8px; }
footer ul { margin: 0; padding-left: 18px; }

@media (max-width: 560px) {
  .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .phase-head { grid-template-columns: auto minmax(0, 1fr); }
  .tag { grid-column: 2; justify-self: start; }
  .arrow { display: none; }
  .hull { border-radius: 10px; }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } html { scroll-behavior: auto; } }
html { scroll-behavior: smooth; }
</style>

<div class="wrap">
  <header class="hero">
    <span class="badge">Installation Runbook</span>
    <h1>Starlink + UniFi<br><span class="grad">Passenger Wi-Fi Setup</span></h1>
    <p>Step-by-step: plan and materials → Starlink → UCG Ultra → switches and APs → voucher portal → commissioning. Follow each phase in order.</p>
    <div class="vessel"><strong>M/V Virgen de Peñafrancia XII</strong> · Star Horse Shipping Lines · 82 m RoRo passenger ferry · Updated 5 Nov 2026</div>
    <div class="stats">
      <div class="stat"><b>6</b><span>Access points</span></div>
      <div class="stat"><b>2</b><span>PoE switches</span></div>
      <div class="stat"><b>2</b><span>Wi-Fi networks</span></div>
      <div class="stat"><b>1</b><span>Starlink dish</span></div>
    </div>
    <nav class="pills" aria-label="Phases">
      <a class="pill" href="#plan" style="--c:var(--s1)"><i></i>Plan</a>
      <a class="pill" href="#materials" style="--c:var(--s2)"><i></i>Materials</a>
      <a class="pill" href="#layout" style="--c:var(--s3)"><i></i>Vessel layout</a>
      <a class="pill" href="#starlink" style="--c:var(--s4)"><i></i>Starlink</a>
      <a class="pill" href="#gateway" style="--c:var(--s1)"><i></i>UCG Ultra</a>
      <a class="pill" href="#aps" style="--c:var(--s2)"><i></i>Switches + APs</a>
      <a class="pill" href="#vouchers" style="--c:var(--s3)"><i></i>Vouchers</a>
      <a class="pill" href="#security" style="--c:var(--s4)"><i></i>Security</a>
      <a class="pill" href="#commission" style="--c:var(--s1)"><i></i>Go live</a>
    </nav>
  </header>

  <!-- PHASE 00 -->
  <section class="phase" id="plan" style="--c:var(--s1)">
    <div class="phase-head">
      <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3 8-8"/><path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></div>
      <div><h2>Plan before buying</h2><p>Settle the Starlink service plan, cable distances and power before any hardware is ordered.</p></div>
      <span class="tag">Phase 00</span>
    </div>
    <ol class="steps">
      <li class="step"><span class="num">1</span><div class="step-body">
        <h3>Confirm the Starlink service plan</h3>
        <p>The Standard kit is approved for vessels, but most plans are not. A daily ferry also passes Roam's limit of 5 consecutive days and 60 days per year in territorial waters.</p>
        <div class="tablebox" style="margin-top:4px"><table>
          <thead><tr><th>Plan</th><th>On this vessel</th><th>Notes</th></tr></thead>
          <tbody>
            <tr><td>Residential / Standard / Priority</td><td><span class="chip no">Not allowed</span></td><td>In-motion use is not permitted</td></tr>
            <tr><td>Roam</td><td><span class="chip maybe">Short-term only</span></td><td>Coastal waters, with day limits. Not for a daily commercial route</td></tr>
            <tr><td>Roam + Ocean Mode</td><td><span class="chip have">Works</span></td><td>Beyond 12 nautical miles and past the day limits. Billed per GB</td></tr>
            <tr><td>Business Maritime / Mobile Priority</td><td><span class="chip have">Recommended</span></td><td>Commercial use, network priority</td></tr>
          </tbody>
        </table></div>
        <div class="note verify"><span><b>Verify:</b> Starlink or a local reseller confirms in writing that the plan covers commercial passenger Wi-Fi on your route.</span></div>
      </div></li>
      <li class="step"><span class="num">2</span><div class="step-body">
        <h3>Measure every cable run on board</h3>
        <ul>
          <li>Dish position (compass deck) down to the wheelhouse. Compare with the supplied Starlink cable length.</li>
          <li>Wheelhouse to the 2nd deck switch location (midships).</li>
          <li>Each switch to each AP position, including vertical drops and tray detours.</li>
        </ul>
        <div class="note verify"><span><b>Verify:</b> every Cat6 run is under 90 m, leaving margin under the 100 m Ethernet limit.</span></div>
      </div></li>
      <li class="step"><span class="num">3</span><div class="step-body">
        <h3>Check power at both equipment points</h3>
        <p>The Starlink power supply runs on 100–240 V AC. Confirm 220 V AC outlets in the wheelhouse and at the 2nd deck switch location. Add an inverter only where AC is missing.</p>
        <div class="note warn"><span>Clear every bulkhead and deck penetration with the shipping line's naval architect before drilling. Each pass needs an approved fire- and watertight transit.</span></div>
      </div></li>
    </ol>
  </section>

  <!-- PHASE 01 -->
  <section class="phase" id="materials" style="--c:var(--s2)">
    <div class="phase-head">
      <div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></svg></div>
      <div><h2>Bill of materials</h2><p>Quantities for 6 APs, one per passenger area. Prices are PH store listings checked 5 Nov 2026; most are sold out or pre-order, so confirm stock first.</p></div>
      <span class="tag">Phase 01</span>
    </div>
    <div class="tablebox"><table>
      <thead><tr><th>Item</th><th>Status</th><th>Model / spec</th><th>Qty</th><th>Where / why</th><th>Est. price (PHP)</th></tr></thead>
      <tbody>
        <tr><td>Starlink Standard (V4) kit</td><td><span class="chip have">Have</span></td><td>Dish UTA-232, router UTR-251, PSU UTP-253L</td><td class="qty">1</td><td>Satellite link</td><td>—</td></tr>
        <tr><td>Cloud Gateway Ultra</td><td><span class="chip have">Have</span></td><td>UCG-Ultra</td><td class="qty">1</td><td>Router, VLANs, Hotspot Manager, vouchers</td><td>—</td></tr>
        <tr><td>Access point</td><td><span class="chip buy">Buy</span></td><td>U6+, Wi-Fi 6, ceiling, PoE (9 W max)</td><td class="qty">5</td><td>Canteen, reclining room, VIP hallway, 2 bunk rooms</td><td class="qty">6,590–8,800 each</td></tr>
        <tr><td>Economy area AP</td><td><span class="chip maybe">Decide</span></td><td>U6+ if sheltered; U6 Mesh (IPX5) if exposed</td><td class="qty">1</td><td>Economy seating, 2nd deck aft</td><td class="qty">6,590–8,800 / 15,350</td></tr>
        <tr><td>PoE switch, wheelhouse</td><td><span class="chip buy">Buy</span></td><td>USW Lite 8 PoE (52 W, 4 PoE+ ports)</td><td class="qty">1</td><td>3 APs (~27 W), uplink, crew PC via UCG</td><td class="qty">8,760–9,300</td></tr>
        <tr><td>PoE switch, 2nd deck</td><td><span class="chip buy">Buy</span></td><td>USW Lite 8 PoE (52 W, 4 PoE+ ports)</td><td class="qty">1</td><td>3 APs (~30 W), 1 spare PoE port</td><td class="qty">8,760–9,300</td></tr>
        <tr><td>Shielded Cat6</td><td><span class="chip buy">Buy</span></td><td>305 m boxes; UV-rated for exposed runs</td><td class="qty">~2</td><td>AP runs, uplink, spare runs</td><td class="m-tbd">Get quote</td></tr>
        <tr><td>Cabling accessories</td><td><span class="chip buy">Buy</span></td><td>RJ45 / keystones, patch cords, ties, labels</td><td class="qty">1 lot</td><td>Terminate and label every run</td><td class="m-tbd">Get quote</td></tr>
        <tr><td>Bulkhead / deck transits</td><td><span class="chip buy">Buy</span></td><td>Approved fire- and watertight</td><td class="qty">Per pass</td><td>Every cable penetration</td><td class="m-tbd">Get quote</td></tr>
        <tr><td>Rigid dish mount</td><td><span class="chip buy">Buy</span></td><td>Marine pole or flat mount</td><td class="qty">1</td><td>Compass deck. No kickstand at sea</td><td class="m-tbd">Get quote</td></tr>
        <tr><td>UPS, wheelhouse</td><td><span class="chip buy">Buy</span></td><td>Online UPS, ~1 kVA</td><td class="qty">1</td><td>UCG, switch, Starlink PSU</td><td class="m-tbd">Get quote</td></tr>
        <tr><td>UPS, 2nd deck</td><td><span class="chip buy">Buy</span></td><td>Small UPS</td><td class="qty">1</td><td>Deck 2 switch</td><td class="m-tbd">Get quote</td></tr>
        <tr><td>Network cabinet</td><td><span class="chip buy">Buy</span></td><td>Lockable, ventilated wall cabinet</td><td class="qty">2</td><td>Wheelhouse and 2nd deck</td><td class="m-tbd">Get quote</td></tr>
        <tr><td>Surge-protected power strip</td><td><span class="chip buy">Buy</span></td><td>Marine or industrial grade</td><td class="qty">2</td><td>One per cabinet</td><td class="m-tbd">Get quote</td></tr>
        <tr><td>Longer Starlink cable</td><td><span class="chip maybe">If needed</span></td><td>Official Starlink cable</td><td class="qty">0–1</td><td>Only if the dish run exceeds the supplied cable</td><td class="m-tbd">Get quote</td></tr>
        <tr><td>Inverter</td><td><span class="chip maybe">If needed</span></td><td>Pure sine wave</td><td class="qty">0–2</td><td>Only where 220 V AC is missing</td><td class="m-tbd">Get quote</td></tr>
        <tr><td>Voucher printer</td><td><span class="chip no">Optional</span></td><td>Receipt or A4 printer</td><td class="qty">1</td><td>Purser or cashier</td><td class="m-tbd">Get quote</td></tr>
      </tbody>
    </table></div>
    <div class="note info" style="margin-top:14px"><span><b>APs + switches total:</b> about ₱57,000–71,000 if the economy area uses a U6+, or ₱66,000–78,000 with a U6 Mesh. The U6+ draws only 9 W, so the 52 W USW Lite 8 PoE carries three APs per deck with headroom.</span></div>
  </section>

